# Copy the SMTP settings into your ignored .env file and replace these values.
# Use a Google App Password here, never your regular Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@fintrack.local
